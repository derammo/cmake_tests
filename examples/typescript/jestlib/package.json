{
  "author": "derammo",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "brace-expansion": ">5.0.8",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "licenses"
  ],
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "reporters": [
      "default",
      "jest-junit"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true,
            "module": "commonjs"
          }
        }
      ]
    }
  },
  "license": "UNLICENSED",
  "name": "@cmake-example/jestlib",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit && tsc --watch --noEmit",
    "clean": "rm -rf ./dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "format": "prettier --print-width 120 --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "lint": "eslint",
    "start": "node dist/index",
    "test": "npm run jest",
    "test:watch": "npm run jest:watch"
  },
  "type": "module",
  "version": "1.0.0"
}
